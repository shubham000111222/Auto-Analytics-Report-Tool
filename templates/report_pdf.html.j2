<!DOCTYPE html>
<html><head><meta charset="utf-8"><title>Analytics Report -- {{ filename }}</title>
<style>
@page { size: A4; margin: 2cm; }
body{font-family:Arial,sans-serif;color:#1a1a1a;font-size:11pt}
h1{border-bottom:2px solid #333;padding-bottom:.3cm}
h2{margin-top:1.2cm;border-bottom:1px solid #ddd;padding-bottom:.2cm}
.chart-block{margin-bottom:1cm;page-break-inside:avoid}
.chart-block img{max-width:100%;}
.takeaway{color:#555;font-style:italic}
.narrative{background:#f7f7f7;padding:.5cm 1cm;border-radius:6px;white-space:pre-wrap}
.caveats{background:#fff8e6;border:1px solid #f0d78c;padding:.5cm 1cm;border-radius:6px}
</style></head>
<body>
<h1>Analytics Report</h1>
<p><strong>File:</strong> {{ filename }} | <strong>Generated:</strong> {{ generated_at }}</p>
<p><strong>Rows:</strong> {{ profile.n_rows }} <strong>Columns:</strong> {{ profile.n_cols }}
   <strong>Duplicate rows:</strong> {{ profile.duplicate_rows }}</p>
{% if narrative %}<h2>Executive Summary</h2><div class="narrative">{{ narrative }}</div>{% endif %}
{% for section in sections %}
<h2>{{ loop.index + 2 }}. {{ section.title }}</h2>
{% for chart in section.charts %}
<div class="chart-block">
  <h3>{{ chart.title }}</h3>
  <img src="data:image/png;base64,{{ chart.img_b64 }}" />
  <p class="takeaway">{{ chart.takeaway }}</p>
</div>
{% endfor %}
{% endfor %}
{% if caveats %}
<h2>Recommendations &amp; Caveats</h2>
<ul class="caveats">{% for c in caveats %}<li>{{ c }}</li>{% endfor %}</ul>
{% endif %}
</body></html>
